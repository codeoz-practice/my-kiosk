generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: url은 prisma.config.ts에서 관리 (schema에 url 없음)
}

// 계정의 시스템상 역할일 뿐, 매장 소유 관계는 Shop.ownerId로만 판단한다.
// MANAGER: 특정 매장에 소속되지 않는 전사 고객지원 센터 계정.
enum UserType {
  USER
  MANAGER
  OWNER
}

// 모델 정의는 여기에 추가
// 예시:
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  userType UserType @default(USER) @map("user_type")

  ownedShops ShopOwner[]
  tickets Ticket[]
  orders Order[]
  usageSessions UsageSession[]
  ticketProductHistories TicketProductHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

enum LedgerStatus {
  HELD
  RELEASABLE
  SETTLED
  CLAWBACK_PENDING
}

model Ledger {
  id String @id @default(uuid())
  sellerId String
  tradeId String
  amount Int
  status LedgerStatus
  settledAt DateTime?
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([tradeId])
}

enum TicketType {
  TIME   // 시간권
  PERIOD // 정기권
}

enum TicketStatus {
  UNUSED    // 미사용 (시간권: 미사용, 정기권: 미활성화)
  ACTIVE    // 사용 중 (정기권 활성화됨)
  EXPIRED   // 만료 (기간 초과)
  EXHAUSTED // 소진 (시간권 분 다 씀)
  REVOKED   // 관리자 강제 소멸
  // PAUSED 상태는 TicketPause를 조인해서 조회한다. (관리자가 직접 처리하는 구조로 성능 이슈 발생 시 추가한다.)
}

model Ticket {
  id String @id @default(uuid())
  userId String @map("user_id")
  type TicketType
  
  // 시간권 전용
  minuteExpireAt DateTime? @map("minute_expire_at") // 이 날까지 분 소진 안 하면 소멸(구매일 + product.usableDays)
  remainingMinutes Int? @map("remaining_minutes") // ⭐️ 잔여 시간의 유일한 원천(시간권만 사용)

  // 정기권 전용
  activateBy DateTime? @map("activate_by")   // 이 날까지 활성화 안 하면 소멸(구매일 + product.usableDays)
  activatedAt DateTime? @map("activated_at") // 첫 입장(활성화) 시각
  expiresAt DateTime? @map("expires_at")     // ⭐️ activatedAt + durationDays 로 계산해서 저장

  status TicketStatus @default(UNUSED)
  
  user User @relation( fields: [userId], references: [id])

  pauses TicketPause[]
  usageSessions UsageSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItemId String @unique @map("order_item_id")
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  
  // 관리자: 최근 변경된 티켓 목록
  @@index([status, updatedAt])
  
  // 사용자: 내 티켓 목록 (만료일 가까운 순)
  @@index([userId, expiresAt])
  @@index([userId, minuteExpireAt])
  
  // 사용자: 내 티켓 구매일 정렬
  @@index([userId, createdAt])
  @@map("tickets")
}

model TicketPause {
  id String @id @default(uuid())
  ticketId String @map("ticket_id")
  
  pausedAt DateTime @map("paused_at")          // 일시정지 시작
  pausedReason String? @map("paused_reason")   // 정지사유
  pausedBy String @map("paused_by")            // 누가 정지를 시켰는가

  resumedAt DateTime? @map("resumed_at")       // 재개 시간(null 이면 현재 정지 중)
  resumedReason String? @map("resumed_reason") // 재개 사유
  resumedBy String? @map("resumed_by")         // 누가 재개 시켰는가
  
  ticket Ticket @relation(fields: [ticketId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, updatedAt])
  @@map("ticket_pauses")
}

// 상품 목록 모델(delete 쿼리 금지!)
/**
Prisma 미들웨어로 delete 차단
prisma.$use(async (params, next) => {
  if (params.model === 'TicketProduct' && params.action === 'delete')
  {
    throw new Error('TicketProduct는 삭제할 수 없습니다. deletedAt을 
사용하세요.')
  }
  return next(params)                                                
})
**/
model TicketProduct {
  id String @id @default(uuid())
  name String
  type TicketType
  price Int // 금액
  shopId String @map("shop_id")

  totalMinutes Int? @map("total_minutes") // 시간권 전용(구매시간)
  durationDays Int? @map("duration_days") // 정기권 전용(구매기간)

  usableDays Int @map("usable_days") // 공통 - 구매 후 며칠 안에 사용/활성화해야 하는 상품인가
  isActive Boolean @default(true) @map("is_active") // 판매 활성화 유무

  orderItems OrderItem[]
  ticketProductHistories TicketProductHistory[]
  shop Shop @relation(fields: [shopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // 소프트 삭제 필드

  @@map("ticket_products")
}

model Order {
  id String @id @default(uuid())
  userId String @map("user_id")
  
  originalPrice   Int @map("original_price")  // 할인 전 금액
  discountAmount  Int @default(0) @map("discount_amount") // 할인 금액
  totalAmount     Int @map("total_amount")    // 실결제 금액

  orderItems OrderItem[]
  payments Payment[]

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())
  price Int // 구매 시점 가격 스냅샷
  totalMinutes Int? @map("total_minutes") // 시간권: 구매 시점 분 스냅샷
  durationDays Int? @map("duration_days") // 정기권: 구매 시점 기간 스냅샷
  orderId String @map("order_id")
  productId String @map("product_id")

  ticket Ticket?
  product TicketProduct @relation(fields: [productId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("order_items")
}

enum PaymentType {
  CARD
  CASH
}
enum VanType {
  NICE  // 나이스페이
  KCP   // KCP
  KSNET // KSNET
}
enum PaymentStatus {
  PENDING    // 결제 대기 (주문 생성, 아직 요청 안 함)
  REQUESTED  // 승인 요청 중 (VAN사에 요청 전송)
  SUCCESS    // 결제 성공
  FAILED     // 결제 실패
  CANCELLED  // 결제 취소 
}

model Payment {
  id String @id @default(uuid())
  type PaymentType // 결재 타입(카드, 현금)
  status PaymentStatus @default(PENDING)
  orderId String @map("order_id")
  price Int   // 결재 금액
  van VanType? // 카드 대행사
  requestedAt DateTime? @map("requested_at") // VAN사 승인 요청 시각
  approvedAt DateTime? @map("approved_at")   // 승인 완료 시각
  cancelledAt DateTime? @map("cancelled_at") // 취소 시각

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
}

enum UsageSessionStatus {
  ACTIVE
  ENDED
}

// 실제 이용중인 이용권 관리 모델
// 정기권: 만료일 체크만 수행, planned_end_at/BullMQ 등록 없음 (소비 개념이 없으므로)
model UsageSession {
  id String @id @default(uuid())
  ticketId String @map("ticket_id")
  seatId String @map("seat_id")
  shopId String @map("shop_id")
  userId String @map("user_id")
  startedAt DateTime @default(now()) @map("started_at")
  plannedEndAt DateTime @map("planned_end_at") // 시작 시점의 이용권 잔여시간으로 계산한 예정 종료 시간
  endedAt DateTime? @map("ended_at") // 실제 종료 시각(조기퇴실이면 plannedEndAt 보다 빠름)
  status UsageSessionStatus @default(ACTIVE)
  bullmqJobId String

  ticket Ticket @relation(fields: [ticketId], references: [id])
  seat Seat @relation(fields: [seatId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])
  user User @relation(fields: [userId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 매장별 이용중인 좌석 조회
  @@index([shopId, status])
  // 현재 사용자가 이용 중인 좌석 조회
  @@index([userId, status, updatedAt])

  @@map("usage_sessions")
}

// 티겟 상품 변경 이력 관리 모델(delete/update 불가 이력 관리용)
model TicketProductHistory {
  id String @id @default(uuid())
  changeGroupId String @map("change_group_id") // 동시에 여러 필드가 바뀐 '한 번의 수정'을 묶는 그룹 id 
  ticketProductId String @map("ticket_product_id")
  changedField String @map("changed_field")
  oldValue String? @map("old_value")
  newValue String? @map("new_value")
  changedBy String @map("changed_by")
  user User @relation(fields: [changedBy], references: [id])

  ticketProduct TicketProduct @relation(fields: [ticketProductId], references: [id])

  changedAt DateTime @default(now()) @map("changed_at")

  // 상품별 변경 이력 조회
  @@index([ticketProductId, changedAt])
  // 같은 시점 변경 묶음 조회
  @@index([changeGroupId])

  @@map("ticket_product_histories")
}

// 매장 관리 모델
model Shop {
  id String @id @default(uuid())
  name String @unique
  owners ShopOwner[] // 이 매장의 공동 점주 목록. 점주 한 명이 여러 매장을 가질 수도 있다(User.ownedShops 참고).
  seats Seat[]
  products TicketProduct[]
  usageSessions UsageSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isActive  Boolean   @default(true) @map("is_active") // 운영 중 여부
  deletedAt DateTime? @map("deleted_at") // 소프트 삭제

  @@index([name])

  @@map("shops")
}

// Shop ↔ User의 N:N 관계(공동 점주). 명시적 조인 모델로 두어
// "언제부터 점주가 되었는지" 같은 부가 정보를 붙일 수 있게 한다.
model ShopOwner {
  shopId String @map("shop_id")
  userId String @map("user_id")

  shop Shop @relation(fields: [shopId], references: [id])
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") // 점주로 등록된 시점

  @@id([shopId, userId])
  @@map("shop_owners")
}

// 좌석 관리 모델
model Seat {
  id String @id @default(uuid())
  number Int
  name String
  shopId String @map("shop_id")
  shop Shop @relation(fields: [shopId], references: [id])
  usageSession UsageSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // 매장별 좌석 조회 및 정렬
  @@index([shopId, number])
  @@map("seats")
}